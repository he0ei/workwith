{
  "name": "workwith",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workwith-db",
      "database_id": "50cd5d06-b72f-4a73-a05d-ee6a3d49b8c8",
      "migrations_dir": "migrations"
    }
  ]
}
